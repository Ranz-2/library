@model List<Member>
@{
    ViewData["Title"] = "Members";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-0 fw-bold">Members</h1>
        <p class="text-white-50 mb-0">@Model.Count registered borrowers</p>
    </div>
    <a asp-action="Create" class="btn-primary-glass">+ Add Member</a>
</div>

<div class="table-responsive">
    <table class="table table-glass align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Type</th>
                <th class="text-center">Books Out</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in Model)
            {
                <tr>
                    <td class="fw-bold">@member.FullName</td>
                    <td class="text-white-50">@(member.Email ?? "—")</td>
                    <td><span class="badge-glass">@member.MemberType</span></td>
                    <td class="text-center">
                        @if(member.OpenLoans > 0) {
                            <span class="badge bg-warning text-dark">@member.OpenLoans</span>
                        } else {
                            <span class="text-white-50">0</span>
                        }
                    </td>
                  <td class="text-end">
    <div class="d-flex justify-content-end gap-1">
        <a asp-action="Details" asp-route-id="@member.MemberId" class="btn btn-sm btn-glass">Details</a>
        <a asp-action="Edit" asp-route-id="@member.MemberId" class="btn btn-sm btn-glass">Edit</a>
        <a asp-action="Delete" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-danger">Delete</a>
    </div>
</td>
                </tr>
            }
        </tbody>
    </table>
</div>