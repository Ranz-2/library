@{
    ViewData["Title"] = "Home";
}

<div class="lib-page">

    <section class="lib-hero">
        <h1>The University Library</h1>
        <p>A small catalogue of books and the people who borrow them.</p>
    </section>

    <div class="lib-grid">
        <div class="lib-card">
            <h3 class="lib-card-title">Books</h3>
            <p class="lib-card-meta">Browse, add, edit and remove titles from the catalogue.</p>
            <div class="lib-card-actions">
                <a asp-controller="Books" asp-action="Index" class="lib-btn lib-btn-primary">Open catalogue</a>
            </div>
        </div>

        <div class="lib-card">
            <h3 class="lib-card-title">Members</h3>
            <p class="lib-card-meta">Manage the students, faculty and regular borrowers.</p>
            <div class="lib-card-actions">
                <a asp-controller="Members" asp-action="Index" class="lib-btn lib-btn-primary">Open members</a>
            </div>
        </div>
    </div>

</div>