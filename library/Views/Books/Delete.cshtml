@model Book
@{
    ViewData["Title"] = "Delete a book";
}

<div class="lib-page">

    <div class="lib-danger-box">
        <h1>Delete a book</h1>
        <p>Are you sure you want to delete this book? This cannot be undone.</p>

        <dl class="lib-detail-list">
            <dt>Title</dt>
            <dd>@Model.Title</dd>

            <dt>Category</dt>
            <dd>@(Model.Category ?? "—")</dd>

            <dt>Price</dt>
            <dd>@(Model.Price?.ToString("N2") ?? "—")</dd>
        </dl>

        <p class="lib-card-meta">Any loans of this book are deleted with it.</p>

        <form asp-action="Delete" asp-route-id="@Model.BookId" method="post">
            <div class="lib-actions">
                <button type="submit" class="lib-btn lib-btn-danger">Delete</button>
                <a asp-action="Index" class="lib-btn lib-btn-ghost">Cancel</a>
            </div>
        </form>
    </div>

</div>