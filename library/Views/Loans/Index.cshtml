@model List<LoanView>
@{
    ViewData["Title"] = "Loans";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-0 fw-bold">Active Loans</h1>
        <p class="text-white-50 mb-0">@Model.Count records found</p>
    </div>
    <a asp-action="Borrow" class="btn-primary-glass">Borrow a Book</a>
</div>

<div class="table-responsive">
    <table class="table table-glass align-middle">
        <thead>
            <tr>
                <th>Book</th>
                <th>Member</th>
                <th>Loaned</th>
                <th>Due</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var loan in Model)
            {
                <tr>
                    <td class="fw-bold">@loan.BookTitle</td>
                    <td class="text-white-50">@loan.MemberName</td>
                    <td class="text-white-50">@(loan.LoanedOn?.ToString("MMM dd") ?? "—")</td>
                    <td class="text-white-50">@(loan.LoanedOn?.AddDays(loan.DaysAllowed).ToString("MMM dd") ?? "—")</td>
                    <td>
                        @if (loan.Status == "Overdue")
                        {
                            <span class="badge bg-danger">Overdue</span>
                        }
                        else if (loan.Status == "Out")
                        {
                            <span class="badge bg-warning text-dark">Out</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Returned</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (loan.ReturnedOn == null)
                        {
                            <form asp-action="Return" asp-route-id="@loan.LoanId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-glass">Return</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>