@model List<LoanView>
@{
    ViewData["Title"] = "Loans";
}

<a asp-action="Details" asp-route-id="@member.MemberId"
   class="btn btn-sm btn-outline-primary">Loans</a>
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Loans</h1>
        <p class="text-muted mb-0">@Model.Count loans, newest first</p>
    </div>
    <a asp-action="Borrow" class="btn btn-primary">Borrow a book</a>
    <div class="d-flex gap-3 mb-3">
    <span class="badge text-bg-warning">Out: @Model.Count(l => l.Status == "Out")</span>
    <span class="badge text-bg-danger">Overdue: @Model.Count(l => l.Status == "Overdue")</span>
    <span class="badge text-bg-secondary">Returned: @Model.Count(l => l.Status == "Returned")</span>
</div>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <tr class="border-start border-4 @(loan.Status == "Overdue" ? "border-danger" : loan.Status == "Out" ? "border-warning" : "border-secondary")">
            <th>Member</th>
            <th>Book</th>
            <th>Loaned</th>
            <th>Due</th>
            <th>Status</th>
            <th style="width:7rem"></th>
        </tr>
        <th class="text-end">Books out</th>
        <td class="text-end">@member.OpenLoans</td>
    </thead>
    <tbody>
        @foreach (var loan in Model)
        {
            <tr>
                <td>@loan.MemberName</td>
                <td>@loan.BookTitle</td>
                <td>@(loan.LoanedOn.ToString("yyyy-MM-dd"))</td>
                <td>@(loan.LoanedOn.AddDays(loan.DaysAllowed).ToString("yyyy-MM-dd"))</td>
                <td>
                    <span class="badge @(loan.Status == "Overdue" ? "text-bg-danger"
                                        : loan.Status == "Out" ? "text-bg-warning"
                                        : "text-bg-secondary")">@loan.Status</span>
                </td>
                <td class="text-end">
    @if (loan.ReturnedOn == null)
    {
        <form asp-action="Return" asp-route-id="@loan.LoanId" method="post">
            <button type="submit" class="btn btn-sm btn-outline-success">Return</button>
        </form>
    }
</td>
            </tr>
        }
    </tbody>
</table>