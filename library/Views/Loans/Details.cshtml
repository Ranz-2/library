@model MemberDetails
@{
    ViewData["Title"] = Model.Member.FullName;
}

<div class="dash-card mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="mb-1 text-neon">@Model.Member.FullName</h1>
            <p class="text-secondary mb-0">Member Type: <span class="badge bg-secondary">@Model.Member.MemberType</span></p>
        </div>
        <a asp-action="Index" class="btn btn-outline-light">Back to Directory</a>
    </div>
</div>

<h3 class="mb-4">Borrowing History</h3>

@if (Model.Loans.Count == 0)
{
    <div class="alert alert-dark border-secondary text-secondary">
        No borrowing history found for this member.
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var loan in Model.Loans)
        {
            <div class="col-md-6">
                <div class="dash-card p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="text-light mb-1">@loan.BookTitle</h5>
                        @if (loan.Status == "Overdue")
                        {
                            <span class="badge bg-danger">Overdue</span>
                        }
                        else if (loan.Status == "Out")
                        {
                            <span class="badge bg-warning text-dark">Out</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Returned</span>
                        }
                    </div>
                    <div class="mt-2 text-secondary small">
                        <div>Loaned: @(loan.LoanedOn?.ToString("yyyy-MM-dd") ?? "—")</div>
                        <div>Returned: @(loan.ReturnedOn?.ToString("yyyy-MM-dd") ?? "—")</div>
                    </div>
                </div>
            </div>
        }
    </div>
}