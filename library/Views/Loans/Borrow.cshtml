@model BorrowForm
@{
    ViewData["Title"] = "Borrow a book";
}

<div class="d-flex justify-content-center mt-5">
    <div class="dash-form w-100">
        <h2 class="mb-4 text-center text-neon">Checkout Book</h2>
        
        <form asp-action="Borrow" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="mb-3">
                <label asp-for="MemberId" class="form-label text-secondary">Select Borrower</label>
                <select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select">
                    <option value="">-- Choose Member --</option>
                </select>
                <span asp-validation-for="MemberId" class="text-danger small"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="BookId" class="form-label text-secondary">Select Book</label>
                <select asp-for="BookId" asp-items="ViewBag.Books" class="form-select">
                    <option value="">-- Choose Book --</option>
                </select>
                <span asp-validation-for="BookId" class="text-danger small"></span>
            </div>
            
            <div class="mb-4">
                <label asp-for="DaysAllowed" class="form-label text-secondary">Loan Duration (Days)</label>
                <input asp-for="DaysAllowed" class="form-control" type="number" />
                <span asp-validation-for="DaysAllowed" class="text-danger small"></span>
            </div>
            
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-info text-dark fw-bold">Confirm Checkout</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}