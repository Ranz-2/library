@model BorrowForm

@{
    ViewData["Title"] = "Borrow a book";
}

<h1 class="mb-3">Borrow a book</h1>

<form asp-action="Borrow" method="post" class="card card-body" style="max-width:36rem">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

   <form asp-action="Borrow" method="post" class="card card-body shadow-sm" style="max-width:42rem">
    <div class="row g-3">
        <div class="col-md-6">...Member select...</div>
        <div class="col-md-6">...Book select...</div>
        <div class="col-12">...Days allowed...</div>
    </div>
    <div class="d-grid gap-2 mt-3">
        <button type="submit" class="btn btn-success">📚 Borrow</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>
    </div>
</form>

    <div class="mb-3">
        <label asp-for="DaysAllowed" class="form-label">Days allowed</label>
        <input asp-for="DaysAllowed" class="form-control" />
        <span asp-validation-for="DaysAllowed" class="text-danger"></span>
    </div>

    <div>
        <button type="submit" class="btn btn-primary">Borrow</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}